      "value": "http://localhost:3000"
    },
    {
      "key": "mobile_access_token",
      "value": ""
    },
    {
      "key": "mobile_email",
      "value": ""
    },
    {
      "key": "mobile_password",
      "value": ""
    },
    {
      "key": "tumizi_withdrawal_phone",
